{
  "environment" : {
    "set_vars" : {
      "CODEX_HOME" : "\/Users\/test\/Library\/Application Support\/Hearth\/agents\/codex"
    }
  },
  "extends" : "default",
  "filesystem" : {
    "allow" : [
      "\/Users\/test\/Library\/Application Support\/Hearth\/runs\/run-1",
      "\/Users\/test\/Library\/Application Support\/Hearth\/agents\/codex",
      "\/Users\/test\/Library\/Keychains"
    ],
    "bypass_protection" : [
      "\/Users\/test\/Library\/Keychains"
    ],
    "read" : [
      "\/Users\/test\/.codex\/AGENTS.md",
      "\/Users\/test\/.codex\/prompts",
      "\/Users\/test\/.codex\/skills"
    ]
  },
  "groups" : {
    "include" : [
      "node_runtime",
      "bun_runtime",
      "python_runtime",
      "go_runtime",
      "go_runtime_macos",
      "rust_runtime",
      "java_runtime",
      "git_config",
      "user_caches_macos",
      "codex_macos"
    ]
  },
  "meta" : {
    "description" : "Hearth IDE: Codex (generated, do not edit)",
    "name" : "hearth-codex"
  },
  "network" : {
    "allow_domain" : [
      "chatgpt.com",
      "auth.openai.com",
      "ab.chatgpt.com"
    ],
    "network_profile" : "developer",
    "open_port" : [
      1455
    ]
  },
  "open_urls" : {
    "allow_localhost" : true,
    "allow_origins" : [
      "https:\/\/auth.openai.com",
      "https:\/\/chatgpt.com"
    ]
  },
  "unsafe_macos_seatbelt_rules" : [
    "(deny file-write* (literal \"\/Users\/test\/code\/project\/.git\/hooks\"))",
    "(deny file-write* (subpath \"\/Users\/test\/code\/project\/.git\/hooks\"))"
  ],
  "workdir" : {
    "access" : "readwrite"
  }
}
