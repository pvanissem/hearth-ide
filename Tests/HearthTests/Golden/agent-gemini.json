{
  "environment" : {
    "set_vars" : {
      "GRADLE_RO_DEP_CACHE" : "\/Users\/test\/.gradle\/caches",
      "GRADLE_USER_HOME" : "\/Users\/test\/Library\/Caches\/Hearth\/gradle",
      "JAVA_TOOL_OPTIONS" : "-Duser.home=\/Users\/test\/Library\/Caches\/Hearth\/home",
      "MAVEN_ARGS" : "-Dmaven.repo.local=\/Users\/test\/Library\/Caches\/Hearth\/m2\/repository -Dmaven.repo.local.tail=\/Users\/test\/.m2\/repository",
      "npm_config_cache" : "\/Users\/test\/Library\/Caches\/Hearth\/npm"
    }
  },
  "extends" : "default",
  "filesystem" : {
    "allow" : [
      "\/Users\/test\/Library\/Application Support\/Hearth\/runs\/run-1",
      "\/Users\/test\/.gemini"
    ],
    "read" : [
      "\/Users\/test\/Library\/Java\/JavaVirtualMachines",
      "\/Users\/test\/.sdkman\/candidates",
      "\/Users\/test\/.gradle\/caches"
    ]
  },
  "groups" : {
    "include" : [
      "node_runtime",
      "bun_runtime",
      "python_runtime",
      "go_runtime",
      "go_runtime_macos",
      "rust_runtime",
      "java_runtime",
      "git_config",
      "user_caches_macos"
    ]
  },
  "meta" : {
    "description" : "Hearth IDE: Gemini CLI (generated, do not edit)",
    "name" : "hearth-gemini"
  },
  "network" : {
    "allow_domain" : [
      "cloudcode-pa.googleapis.com",
      "oauth2.googleapis.com",
      "www.googleapis.com",
      "accounts.google.com",
      "play.googleapis.com"
    ],
    "network_profile" : "developer"
  },
  "open_urls" : {
    "allow_localhost" : true,
    "allow_origins" : [
      "https:\/\/accounts.google.com"
    ]
  },
  "unsafe_macos_seatbelt_rules" : [
    "(deny file-write* (literal \"\/Users\/test\/.gemini\/settings.json\"))",
    "(deny file-write* (literal \"\/Users\/test\/.gemini\/extensions\"))",
    "(deny file-write* (subpath \"\/Users\/test\/.gemini\/extensions\"))",
    "(deny file-write* (literal \"\/Users\/test\/code\/project\/.git\/hooks\"))",
    "(deny file-write* (subpath \"\/Users\/test\/code\/project\/.git\/hooks\"))"
  ],
  "workdir" : {
    "access" : "readwrite"
  }
